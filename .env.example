# Copy this file to .env and fill it in.  NEVER commit .env to GitHub (it's in .gitignore).

# ---- Website ----
# Any long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
WEBSITE_PORT=5000

# Google sign-in (ask Rupesh Sasne for these). Leave empty to use the development sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback
# 1 = show the development sign-in even with Google keys; 0 = never show it. Empty = only when Google keys are missing.
DEV_LOGIN=
# Set to 1 when the site runs on https (not on your laptop)
SESSION_COOKIE_SECURE=0

# ---- Website <-> chat service ----
CHAT_SERVICE_URL=http://127.0.0.1:5001
# Shared secret between the two. Any long random string, the same for both.
CHAT_SERVICE_TOKEN=

# ---- Chat service ----
CHAT_SERVICE_PORT=5001
# Which agent answers. Default: the rule-based stand-in (no API key needed).
CHAT_AGENT=chat_service.agent.rules_agent:RulesAgent
# For the LLM template instead:
# CHAT_AGENT=chat_service.agent.llm_agent:LLMAgent
# ANTHROPIC_API_KEY=
# IPE_MODEL=claude-sonnet-5-5
